# Copy to .env and fill in. All fields are optional; defaults are safe.
# Provider is selected by LLM_PROVIDER. REDLOOP_ prefixed names also work.

# --- LLM backend -------------------------------------------------------------
LLM_PROVIDER=ollama                 # ollama | openrouter | anthropic | groq | openai | gemini | nvidia_nim | kimi
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Cloud providers (only the one(s) you use need a key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
KIMI_API_KEY=
KIMI_MODEL=kimi-k2
KIMI_BASE_URL=https://api.moonshot.ai/v1
SHODAN_API_KEY=

# Cloud providers are never used by executor routing unless explicitly enabled.
ALLOW_CLOUD_ROUTING=false

# --- Scope / audit -----------------------------------------------------------
# REDLOOP_SCOPE_FILE=scope.yaml      # default
# REDLOOP_AUDIT_DB=data/audit.db    # default
# REDLOOP_SANDBOX_IMAGE=redloop-sandbox

# --- VirusTotal (optional; live lookups are disabled without a key) ---
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
